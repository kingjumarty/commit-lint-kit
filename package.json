{
  "name": "commit-lint-kit",
  "version": "1.0.0",
  "description": "A configurable commit message linter that enforces Conventional Commit standards before push.",
  "main": "src/commit-lint.js",
  "type": "commonjs",
  "bin": {
    "commit-lint": "src/commit-lint.js"
  },
  "scripts": {
    "start": "node src/commit-lint.js",
    "test": "node --test test/ || echo 'no tests yet \u2014 add some in test/'",
    "tracker": "node src/achievement-tracker.js",
    "roadmap": "node src/achievement-tracker.js --roadmap",
    "setup": "bash scripts/setup.sh"
  },
  "keywords": [
    "git",
    "commit",
    "lint",
    "conventional-commits",
    "husky"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/commit-lint-kit.git"
  },
  "author": ""
}
